VITE_API_BASE_URL=http://localhost:8000/api

# --- Realtime (Laravel Reverb) ---
# Phai trung voi REVERB_* trong server/.env
# Bo trong hoac khong bat reverb:start thi thong bao van chay, chi hoi dinh ky thay vi tuc thi.
VITE_REVERB_APP_KEY=vivu-local-key
VITE_REVERB_HOST=127.0.0.1
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http